# Copy to .env.local. EXPO_PUBLIC values are embedded in the APK: NEVER secrets.
# Leave unset to disable deployment-specific notification tap routing.
EXPO_PUBLIC_NOTIFICATION_AGENT_ID=
EXPO_PUBLIC_NOTIFICATION_SERVER_URL=
# Optional path to Android Firebase client config; default ./google-services.json.
# Server service-account keys must never be used here.
GOOGLE_SERVICES_JSON=
